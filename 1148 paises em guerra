#include <stdio.h>
#include <stdbool.h>
#include <stdlib.h>
#include <string.h>

int adj[600][600];

void dijkstra(int, int, int);

int main(int argc, char **argv)
{
    int a, v, w;
    int n, m, i, j, t;

    while (scanf("%d %d", &n, &m), n || m)
    {

        for (i = 0; i <= n; ++i)
            for (j = 0; j <= n; ++j)
                adj[i][j] = 0x3f3f3f3f;

        for (i = 0; i < m; ++i)
        {

            scanf("%d %d %d", &a, &v, &w);

            if (adj[v][a] != 0x3f3f3f3f)
                adj[a][v] = adj[v][a] = 0;
            else
                adj[a][v] = w;

        }

        scanf("%d", &t);
        while (t--)
        {

            scanf("%d %d", &a, &v);
            dijkstra(n, a, v);

        }
        patchar_unlocked('\n');

    }

    return 0;

}
void dijkstra(int n, int src, int dest)
{

    int i, j;
    int verso[n + 1];
    int dist[n + 1];

    memset(verso, false, sizeof(verso));

    for (i = 0; i <= n; ++i)
        dist[i] = 0x3f3f3f3f;

    dist[src] = 0;
    for (i = 0; i <= n; ++i)
    {

        int v = -1;
        for (j = 0; j <= n; ++j)
            if (!verso[j] && (v == -1 || dist[j] < dist[v]))
                v = j;

        if (dist[v] == 0x3f3f3f3f)
            break;

        verso[v] = true;
        for (j = 0; j <= n; ++j)
            if (dist[v] + adj[v][j] < dist[j])
                dist[j] = adj[v][j] + dist[v];

    }

    if (dist[dest] < 0x3f3f3f3f)
        printf("%d\n", dist[dest]);
    else
        pats("nao entregue");

}
